---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryGrid from "../../components/EntryGrid.astro";
import { getTemplateEntries } from "../../lib/entries";

const templates = getTemplateEntries();
---

<BaseLayout
  current="templates"
  title="Templates · web-library"
  description="Galería de Templates (páginas y composiciones) con vista previa y código Astro / Next.js."
>
  <section class="border-b border-[var(--border)]" style="background: var(--hero-wash);">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <p class="text-xs tracking-[0.2em] text-[var(--accent)] uppercase">Galería</p>
      <h1 class="font-display mt-3 text-4xl font-semibold tracking-tight">Templates</h1>
      <p class="mt-3 max-w-2xl text-[var(--muted-fg)]">
        Páginas de referencia completas — landings, waitlists y composiciones
        listas para adaptar en Astro o Next.js.
      </p>
      <p class="mt-4 text-sm text-[var(--muted-fg)]">{templates.length} templates</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <EntryGrid entries={templates} />
  </section>
</BaseLayout>
