---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="No encontrado · web-library">
  <div class="mx-auto flex min-h-screen max-w-lg flex-col items-start justify-center px-6">
    <h1 class="font-display text-3xl font-semibold">Entrada no encontrada</h1>
    <p class="mt-3 text-[var(--muted-fg)]">Esa id no existe en la biblioteca.</p>
    <a href="/" class="mt-6 text-[var(--accent)] underline-offset-2 hover:underline">
      Volver a la biblioteca
    </a>
  </div>
</BaseLayout>
