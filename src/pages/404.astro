---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="No encontrado · web-library">
  <div class="mx-auto flex min-h-[60vh] max-w-lg flex-col items-start justify-center px-6">
    <h1 class="font-display text-3xl font-semibold">Página no encontrada</h1>
    <p class="mt-3 text-[var(--muted-fg)]">Esa ruta no existe en web-library.</p>
    <div class="mt-6 flex flex-wrap gap-3 text-sm">
      <a href="/" class="text-[var(--accent)] underline-offset-2 hover:underline">Home</a>
      <a href="/features" class="text-[var(--accent)] underline-offset-2 hover:underline">Features</a>
      <a href="/templates" class="text-[var(--accent)] underline-offset-2 hover:underline">Templates</a>
    </div>
  </div>
</BaseLayout>
