---
import EntryCard from "./EntryCard.astro";
import type { LearningEntry } from "../lib/types";

interface Props {
  entries: LearningEntry[];
  emptyLabel?: string;
}

const { entries, emptyLabel = "Aún no hay entradas en esta galería." } = Astro.props;
---

{
  entries.length === 0 ? (
    <p class="rounded-xl border border-dashed border-[var(--border)] bg-[var(--surface)] px-6 py-12 text-center text-[var(--muted-fg)]">
      {emptyLabel}
    </p>
  ) : (
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => (
        <EntryCard entry={entry} />
      ))}
    </div>
  )
}
