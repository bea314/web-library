---
import type { LearningEntry } from "../lib/types";
import { CATEGORY_LABELS, KIND_LABELS } from "../lib/types";
import EntryPreview from "./EntryPreview.astro";

interface Props {
  entry: LearningEntry;
}

const { entry } = Astro.props;
---

<a
  href={`/entries/${entry.id}`}
  class="group flex flex-col overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] shadow-[0_10px_30px_-24px_rgba(21,32,51,0.45)] transition hover:-translate-y-0.5 hover:border-[var(--accent)]/40 hover:shadow-[0_18px_40px_-24px_rgba(15,118,110,0.35)]"
>
  <div class="pointer-events-none border-b border-[var(--border)] bg-[var(--muted)] p-3">
    <EntryPreview preview={entry.preview} />
  </div>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <div class="flex flex-wrap items-center gap-2 text-xs text-[var(--muted-fg)]">
      <span class="rounded-md bg-[var(--accent-soft)] px-2 py-0.5 font-medium text-[var(--accent)]">
        {KIND_LABELS[entry.kind]}
      </span>
      <span class="rounded-md bg-[var(--muted)] px-2 py-0.5 font-medium text-[var(--foreground)]">
        {CATEGORY_LABELS[entry.category]}
      </span>
    </div>
    <h3 class="font-display text-lg font-semibold tracking-tight text-[var(--foreground)] group-hover:text-[var(--accent)]">
      {entry.title}
    </h3>
    <p class="text-sm leading-relaxed text-[var(--muted-fg)]">
      {entry.description}
    </p>
  </div>
</a>
