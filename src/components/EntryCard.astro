---
import type { LearningEntry } from "../lib/types";
import EntryPreview from "./EntryPreview.astro";

interface Props {
  entry: LearningEntry;
  /** When true, card opens the gallery modal instead of navigating away */
  openInModal?: boolean;
}

const { entry, openInModal = true } = Astro.props;
const initials = entry.title
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase() ?? "")
  .join("");
---

<a
  href={`/entries/${entry.id}`}
  class="gallery-card group flex flex-col overflow-hidden rounded-2xl border border-black/[0.06] bg-white shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition hover:-translate-y-0.5 hover:shadow-[0_12px_28px_-16px_rgba(15,23,42,0.28)] dark:border-white/10 dark:bg-[#121826] dark:shadow-none"
  data-gallery-card
  data-entry-id={entry.id}
  data-open-modal={openInModal ? "true" : "false"}
>
  <div class="pointer-events-none aspect-[4/3] overflow-hidden bg-[#f0f2f5] p-2.5 dark:bg-[#1a2233] sm:p-3">
    <div class="h-full overflow-hidden rounded-xl [&_>_*]:h-full [&_>_*]:min-h-full">
      <EntryPreview preview={entry.preview} />
    </div>
  </div>
  <div class="flex items-center justify-between gap-3 px-3.5 py-2.5">
    <div class="flex min-w-0 items-center gap-2.5">
      <span
        class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#111827] text-[10px] font-semibold tracking-wide text-white dark:bg-[#5ec8a7] dark:text-[#0c1017]"
        aria-hidden="true"
      >
        {initials}
      </span>
      <span class="truncate text-sm font-medium text-[#111827] dark:text-[#e8eef6]">
        {entry.title}
      </span>
    </div>
    <span
      class="inline-flex items-center gap-1 text-[#9aa3b2] transition group-hover:text-[#64748b] dark:text-[#93a0b5]"
      title="Guardar (próximamente)"
      aria-hidden="true"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
      </svg>
    </span>
  </div>
</a>
