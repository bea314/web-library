---
/** Waitlist / launch page template */
---

<div class="overflow-hidden rounded-xl border border-[#d7e0ec] bg-[linear-gradient(165deg,#f8fbff,#eef6f3)] text-[#152033]">
  <div class="px-5 py-10 text-center sm:px-8">
    <p class="text-[10px] tracking-[0.2em] text-[#0f766e] uppercase">Próximo lanzamiento</p>
    <h2 class="font-display mx-auto mt-3 max-w-sm text-2xl font-semibold leading-tight">
      Únete a la lista antes del drop
    </h2>
    <p class="mx-auto mt-2 max-w-xs text-xs leading-relaxed text-[#5b6b82]">
      Template de waitlist: marca, promesa corta y formulario mínimo.
    </p>
    <div class="mx-auto mt-5 flex max-w-sm overflow-hidden rounded-md border border-[#d5deeb] bg-white text-left">
      <span class="flex-1 px-3 py-2 text-xs text-[#93a0b5]">tu@email.com</span>
      <span class="bg-[#0f766e] px-3 py-2 text-xs font-medium text-white">Avisadme</span>
    </div>
  </div>
</div>
