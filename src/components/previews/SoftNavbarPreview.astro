---
/** Soft top nav block — Feature sample */
---

<div class="overflow-hidden rounded-xl border border-[#d7e0ec] bg-white">
  <div class="flex items-center justify-between gap-4 px-5 py-3">
    <div class="flex items-center gap-6">
      <span class="font-display text-sm font-semibold tracking-tight text-[#152033]">
        Lumen
      </span>
      <div class="hidden gap-4 text-sm text-[#5b6b82] sm:flex">
        <span>Producto</span>
        <span>Precios</span>
        <span>Docs</span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <span class="hidden text-sm text-[#5b6b82] sm:inline">Entrar</span>
      <span class="rounded-md bg-[#0f766e] px-3 py-1.5 text-sm font-medium text-white">
        Empezar
      </span>
    </div>
  </div>
  <div class="border-t border-[#e8eef6] bg-[linear-gradient(180deg,#f7fafc,#eef5fb)] px-5 py-10">
    <p class="text-xs tracking-[0.18em] text-[#0f766e] uppercase">Navegación</p>
    <p class="font-display mt-2 max-w-md text-xl font-semibold text-[#152033]">
      Barra clara, CTAs mínimos, sin pills flotantes
    </p>
  </div>
</div>
