---
interface Props {
  current?: "home" | "features" | "templates";
}

const { current = "home" } = Astro.props;

const links = [
  { href: "/", id: "home", label: "Home" },
  { href: "/features", id: "features", label: "Features" },
  { href: "/templates", id: "templates", label: "Templates" },
] as const;
---

<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[color-mix(in_srgb,var(--surface)_88%,transparent)] backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-baseline gap-2">
      <span class="font-display text-lg font-semibold tracking-tight">web-library</span>
      <span class="hidden text-[11px] tracking-[0.16em] text-[var(--muted-fg)] uppercase sm:inline">
        WEB ANALIZER
      </span>
    </a>

    <nav class="flex items-center gap-1 text-sm" aria-label="Principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-md px-3 py-1.5 transition",
              current === link.id
                ? "bg-[var(--accent-soft)] font-medium text-[var(--accent)]"
                : "text-[var(--muted-fg)] hover:text-[var(--foreground)]",
            ]}
            aria-current={current === link.id ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      id="theme-toggle"
      class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-[var(--border)] bg-[var(--surface)] text-[var(--foreground)] transition hover:border-[var(--accent)]"
      aria-label="Cambiar tema"
      title="Tema claro / oscuro"
    >
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="icon-moon hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3a7 7 0 0 0 11.5 11.5z"></path>
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    const root = document.documentElement;
    const key = "web-library-theme";

    function apply(theme) {
      const dark = theme === "dark";
      root.classList.toggle("dark", dark);
      const btn = document.getElementById("theme-toggle");
      if (!btn) return;
      btn.querySelector(".icon-sun")?.classList.toggle("hidden", !dark);
      btn.querySelector(".icon-moon")?.classList.toggle("hidden", dark);
    }

    const stored = localStorage.getItem(key);
    apply(stored === "dark" || stored === "light" ? stored : "light");

    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const next = root.classList.contains("dark") ? "light" : "dark";
      localStorage.setItem(key, next);
      apply(next);
    });
  })();
</script>
